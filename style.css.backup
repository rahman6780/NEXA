* {
    box-sizing: border-box;
}

html,
body {
    margin: 0;
    padding: 0;
    width: 100%;
    min-height: 100%;
}

body {
    font-family: Arial, sans-serif;
    color: white;
    background-color: #020509;
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
}

.app {
    width: 100%;
    max-width: 700px;
    min-height: 100vh;
    margin: auto;
    padding: 12px;
    display: flex;
    flex-direction: column;
}

/* =========================
   HEADER
========================= */

header {
    text-align: center;
    padding: 14px;
    margin-bottom: 8px;
    background: rgba(5, 10, 20, 0.88);
    border-radius: 16px;
    backdrop-filter: blur(8px);
}

header h1 {
    margin: 0;
    font-size: 30px;
    letter-spacing: 5px;
}

header span {
    color: #b8c5d6;
    font-size: 13px;
}

/* =========================
   CHAT
========================= */

#chat {
    flex: 1;
    padding: 12px 2px 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    overflow-y: auto;
    scroll-behavior: smooth;
}

/* Semua bubble */

.message {
    max-width: 82%;
    padding: 11px 14px;
    border-radius: 16px;
    font-size: 15px;
    line-height: 1.5;
    white-space: pre-wrap;
    overflow-wrap: break-word;
}

/* Pesan NEXA - kiri */

.message.nexa {
    align-self: flex-start;
    background: rgba(10, 25, 45, 0.94);
    border-bottom-left-radius: 5px;
    color: white;
}

/* Pesan user - kanan */

.message.user {
    align-self: flex-end;
    background: rgba(0, 110, 220, 0.92);
    border-bottom-right-radius: 5px;
    color: white;
}

/* NEXA sedang berpikir */

.thinking-message {
    opacity: 0.65;
    font-style: italic;
}

/* =========================
   INPUT
========================= */

.input-area {
    display: flex;
    gap: 8px;
    padding: 8px;
    margin-top: 5px;
    background: rgba(5, 10, 20, 0.95);
    border-radius: 16px;
    position: sticky;
    bottom: 5px;
    z-index: 100;
    backdrop-filter: blur(10px);
}

#input {
    flex: 1;
    min-width: 0;
    padding: 12px 14px;
    border: none;
    outline: none;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.1);
    color: white;
    font-size: 15px;
}

#input::placeholder {
    color: #aab4c0;
}

#send {
    padding: 0 18px;
    border: none;
    border-radius: 12px;
    background: #00c8ff;
    color: #001018;
    font-weight: bold;
    cursor: pointer;
}

#send:hover {
    opacity: 0.9;
}

#send:active {
    transform: scale(0.97);
}

/* =========================
   MENU BUTTON
========================= */

.about-btn {
    width: 100%;
    margin-top: 3px;
    padding: 11px;
    border: none;
    border-radius: 12px;
    background: rgba(5, 10, 20, 0.92);
    color: white;
    cursor: pointer;
    font-size: 14px;
    position: relative;
    z-index: 100;
}

.about-btn:hover {
    background: rgba(20, 45, 70, 0.95);
}

.about-btn:active {
    transform: scale(0.98);
}

/* =========================
   ABOUT / CUSTOM BOX
========================= */

.about-box {
    display: none;
    margin-top: 10px;
    padding: 18px;
    background: rgba(3, 10, 20, 0.97);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 16px;
    position: relative;
    z-index: 200;
}

.about-box.show {
    display: block;
}

.about-box h2 {
    margin-top: 0;
}

.about-box p {
    margin: 8px 0;
}

.about-box button,
.preset-btn,
#resetBg,
#closeCustom {
    padding: 10px 14px;
    border: none;
    border-radius: 10px;
    background: #1677ff;
    color: white;
    cursor: pointer;
}

.preset-grid {
    margin: 12px 0;
}

.preset-btn {
    width: 100%;
}

#bgColor {
    width: 100%;
    height: 40px;
    margin: 10px 0;
}

#bgImage {
    width: 100%;
    margin-bottom: 10px;
    color: white;
}

#resetBg,
#closeCustom {
    margin-right: 5px;
}

/* =========================
   MOBILE
========================= */

@media (max-width: 600px) {
    .app {
        padding: 8px;
    }

    .message {
        max-width: 88%;
    }

    header h1 {
        font-size: 28px;
    }

    #send {
        padding: 0 15px;
    }
}

#chat {
    flex: 1;
    min-height: 0;
}
#chat {
    flex: 1;
    min-height: 55vh;
}
/* =========================
   NEXA UI SIZE FIX
========================= */

body {
    font-size: 16px;
}

.app {
    max-width: 760px;
    padding: 14px;
}

header {
    padding: 18px;
    margin-bottom: 10px;
}

header h1 {
    font-size: 34px;
}

header span {
    font-size: 15px;
}

#chat {
    flex: 1;
    min-height: 55vh;
    padding: 14px 4px 20px;
    gap: 12px;
}

.message {
    max-width: 85%;
    padding: 13px 16px;
    font-size: 16px;
    line-height: 1.55;
}

.input-area {
    padding: 10px;
    gap: 10px;
}

#input {
    padding: 14px 16px;
    font-size: 16px;
}

#send {
    padding: 0 20px;
    font-size: 15px;
}

.about-btn {
    padding: 14px;
    margin-top: 5px;
    font-size: 15px;
}

.about-box {
    padding: 20px;
    font-size: 15px;
}
